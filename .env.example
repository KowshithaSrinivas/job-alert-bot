# Copy this file to .env for LOCAL testing only.
# In production (GitHub Actions) these are set as repo Secrets instead
# (Settings -> Secrets and variables -> Actions), never committed.

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youraddress@gmail.com
# Use a Gmail "App Password", not your real password: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_app_password
EMAIL_TO=youraddress@gmail.com

# --- Telegram ---
# Create a bot via @BotFather on Telegram, then message it once and visit
# https://api.telegram.org/bot<token>/getUpdates to find your chat_id
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789
